appname               = agent2api
version               = 3.3.0-beta.4-1
display_name          = Agent2API
desc                  = <b>多提供商账号池 → OpenAI 兼容 API 网关</b>（基于上游 agent2api v3.3.0-beta.4 预发布版（新增 OpenAI Images 接口）），内置官方 Web 控制台与手机端页面；单文件静态二进制，<b>无需 Docker、无需 Node 运行时</b>，安装即用。<br><br>🤖 <b>账号池 → 标准 API：</b><br>- 标准 <code>/v1/chat/completions</code>、<code>/v1/responses</code>、<code>/v1/messages</code>、<code>/v1/models</code><br>- 图片生成与参考图编辑（OpenAI Images 接口，图片模型独立进模型目录）<br>- 多账号轮转、失败重试，本地 SQLite 持久化<br>- 内置 WorkBuddy、小浣熊（Raccoon）、CatPaw、AutoClaw、Qoder、Cline、Trae、ZCode、CodeArts、智谱清言等多家适配，另支持自定义提供商<br><br>🖥️ <b>官方控制台（v3.3.0-beta.4 面板，218 个文件）：</b><br>- 账号管理、模型中心、API 密钥、运行日志、请求报表、定时任务、余额查询、对话测试台<br>- 界面支持简体中文、繁體中文、English、日本語、한국어、Português (BR) 六种语言（简体中文以「中文即键」的基准文案承载）<br>- 手机端入口 <code>/m</code>，并提供 PWA 资源（<code>manifest.webmanifest</code> + <code>sw.js</code>；经网关子路径运行时「添加到主屏」受限，见项目说明）<br>- 统一网关接入，复用飞牛登录态，<b>面板无需独立登录密码</b>，仅管理员可访问<br><br>🔌 <b>下游接入：</b><br>- 独立端口 <code>http://＜飞牛IP＞:3065/v1</code>，任意 OpenAI SDK 直连（统一网关路径仅供面板访问，外部客户端走不通）<br><br>🧩 <b>运行时与许可：</b><br>- 上游为 Rust 静态二进制，要求 glibc ≥ 2.34（实测引用的最高 GLIBC 符号版本），飞牛 fnOS 1.2.x 为 2.36，满足；<b>不依赖应用中心 Node.js 运行时</b><br>- SQLite 以 bundled 方式静态链接，运行时无额外系统依赖<br>- ⚠️ <b>上游自 v3.3.0-beta.2 起改用 AGPL-3.0</b>（此前为 MIT + 使用声明）：本包内置的上游二进制与面板受 AGPL-3.0 约束，许可全文随包（LICENSE.upstream），对应源码可自上游仓库 aimod-cc/Agent2API 获取，详见包内 UPSTREAM.txt<br>- 账号凭据在应用数据目录中以明文存储，请勿在多人共享设备上使用

# 系统要求
# platform 由 build.py 按目标架构改写为 x86 / arm：每个 fpk 只装一个架构的二进制。
# 写成 all 会让另一种架构也能装上跑不起来的包。
platform              = all
os_min_version        = 1.2.0401
source                = thirdparty

# 开发者信息
maintainer            = Agent2API
maintainer_url        = https://github.com/aimod-cc/Agent2API

distributor           = sushazhi
distributor_url       = https://github.com/sushazhi/fnos-agent2api

# 安装控制
ctl_stop              = true

# 下游接入端口（OpenAI 兼容客户端直连；取上游默认端口 3065，统一网关路径不给外部客户端用）
service_port          = 3065
checkport             = true

# 桌面图标配置
desktop_uidir         = ui
desktop_applaunchname = agent2api.Application

# 更新日志
changelog             = v3.3.0-beta.4-1（预发布）<br>1.pin 跟到上游最新预览 v3.3.0-beta.4（2026-10-26 发布，上一个 pin 为 v3.3.0-beta.3）；上游最新正式版仍是 v3.0.8<br>2.官方 Linux 服务端包两架构重新钉住并三方核对（本地实算 = 上游 .sha256 资产 = GitHub API digest）：amd64 10,414,609 B、arm64 10,038,256 B；包内二进制 amd64 15,478,576 B、arm64 14,049,112 B（beta.3 为 13,140,208 / 11,951,592），ELF 架构正确，最高 GLIBC 仍 2.34（飞牛上限 2.36）<br>3.面板 218 个文件（相对 beta.3 新增 7 / 删除 2 / 修改 109）：新增 css/page-routing.css、css/page-routing-trace.css 与 5 种语言的 i18n/*/routing.js；删除 titlebar.js、tooltip.js（上游改用组件库）；补丁后树哈希 bf07ea4a…，两架构逐字节一致<br>4.上游主要变化：新增 OpenAI Images 接口（图片生成与参考图编辑，复用网关鉴权、模型绑定、账号重试与记账）；「路由」页按模型展示参与范围并支持拖动排序、请求跟踪回放一次真实选路、会话粘滞管理、账号导出为 JSON、请求指纹脱敏；更新通道拆成正式版与 beta 版两个独立开关<br>5.适配层复核：全部守卫在 beta.4 面板上通过 —— 资源引用仍是裸相对（根绝对路径 0 个，index.html 引用 51 降到 50）、i18n 五语各 20 个词典域齐全、44 个提供商图标全部仍被引用、SW scope 仍只命中 1 处并改成 ./（子路径下可注册）；网关改写面结论仍是「无需改动」<br>6.网关按 CI 同口径重编（-X main.version=3.3.0-beta.4-1，Go 1.27.3，CGO_ENABLED=0）：修掉 .local-build/bin 里原是 -Version 3.1.0-2 编出的陈旧缓存 —— 代码虽未变，但启动日志与 --version 会报旧版本号<br>7.已知问题（非阻断，沿用上一版）：面板「退出登录」仍是三目写法 window.location.href = e ? "login.html" : "/login"，网关的导航改写正则要求 = 后紧跟字面量而匹配不到，经子路径部署时会跳到站点根而非应用内登录页<br>8.预发布版建议先在测试机上验证再升级
